# The competition clock is fixed by the project brief.
SUPERCHAT_REFERENCE_DATE=2026-11-02
SUPERCHAT_LOG_DIR=runtime/sessions
# Optional OpenAI-compatible planner. Leave blank for offline rule routing.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Local visual search downloads this public model once, then uses the cache.
VISION_MODEL=openai/clip-vit-base-patch32
VISION_OFFLINE=false
# Recommended optional provider (do not commit a real key).
OPENROUTER_API_KEY=
