# The competition clock is fixed by the project brief.
# database and snapshot use the current Asia/Baku date.
SUPERCHAT_DATA_MODE=mock
# SUPERCHAT_REAL_DATA_DIR=/absolute/path/to/preparation_dataset/SuperChat_Real_Data
# SUPERCHAT_CATALOGUE_DB=/absolute/path/to/runtime/catalogue/catalogue.sqlite3
SUPERCHAT_AUTO_REFRESH=true
SUPERCHAT_REFRESH_HOURS=24
# Broader Birmarket collection; zero per-category collects all within the page limit.
BIRMARKET_PER_CATEGORY=100
BIRMARKET_PAGES=10
# Optional JSON mapping: categories to verified /categories/... paths.
# BIRMARKET_CATEGORIES_FILE=/absolute/path/to/categories.json
# Official Aviasales Data API: cached prices, not live inventory.
TRAVELPAYOUTS_API_TOKEN=
SUPERCHAT_REFERENCE_DATE=2026-11-02
SUPERCHAT_LOG_DIR=runtime/sessions
# Optional OpenAI-compatible planner. Leave blank for offline rule routing.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Local visual search downloads this public model once, then uses the cache.
VISION_MODEL=openai/clip-vit-base-patch32
VISION_OFFLINE=false
# local (default, no API charge); hosted opts into sending photos to your AI provider.
VISION_BACKEND=local
# Recommended optional provider (do not commit a real key).
OPENROUTER_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.5-flash-lite
# Alternatively, for a Google AI Studio key, keep OPENROUTER_API_KEY blank:
# AI_API_KEY=your-google-ai-studio-key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
